FROM ruby:3.3-slim

WORKDIR /app

ENV BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3

COPY Gemfile Gemfile.lock ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3 python3-pil python3-yaml fonts-dejavu-core fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/* \
    && bundle install

COPY . .